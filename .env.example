# Copie estas variáveis para o painel de configuração do seu provedor de
# deploy (Railway, Render, etc). Localmente, o docker-compose.yml já define
# valores padrão pra rodar sem precisar configurar nada.

# String de conexao JDBC completa do MySQL gerenciado do seu provedor
DATABASE_URL=jdbc:mysql://HOST:3306/coffeeshop_db

DATABASE_USERNAME=usuario_do_banco
DATABASE_PASSWORD=senha_do_banco

# Porta que a aplicacao vai escutar (a maioria dos provedores define isso
# automaticamente - so ajuste se o seu exigir uma porta especifica)
PORT=8080
